{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "steps": [
    { "step": "setSiteOptions", "options": { "blogname": "Docmed", "blogdescription": "Family clinic on Green Lane", "permalink_structure": "/%postname%/" } },
    { "step": "activateTheme", "themeFolderName": "docmed" },
    { "step": "login", "username": "admin", "password": "password" },
    { "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/themes/docmed/.dev/demo/import.php';" }
  ]
}
