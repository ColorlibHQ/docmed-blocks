{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1296px",
			"wideSize": "1440px"
		},
		"color": {
			"custom": true,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"name": "Base",
					"slug": "base",
					"color": "#ffffff"
				},
				{
					"name": "Surface",
					"slug": "surface",
					"color": "#f5fbff"
				},
				{
					"name": "Contrast",
					"slug": "contrast",
					"color": "#1f1f1f"
				},
				{
					"name": "Muted",
					"slug": "muted",
					"color": "#6b6b6b"
				},
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#0a6fd6"
				},
				{
					"name": "Primary deep",
					"slug": "primary-deep",
					"color": "#0858ad"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#5db2ff"
				},
				{
					"name": "Dark",
					"slug": "dark",
					"color": "#1f1f1f"
				},
				{
					"name": "Divider",
					"slug": "divider",
					"color": "#e3edf5"
				},
				{
					"name": "Overlay",
					"slug": "overlay",
					"color": "#ffffff"
				},
				{
					"name": "On dark",
					"slug": "on-dark",
					"color": "#c7c7c7"
				},
				{
					"name": "On primary",
					"slug": "on-primary",
					"color": "#ffffff"
				},
				{
					"name": "Ink",
					"slug": "ink",
					"color": "#1f1f1f"
				},
				{
					"name": "Wash",
					"slug": "wash",
					"color": "#0858ad"
				}
			],
			"gradients": [
				{
					"name": "Brand",
					"slug": "brand",
					"gradient": "linear-gradient(90deg, var(--wp--preset--color--primary-deep) 0%, var(--wp--preset--color--primary) 100%)"
				},
				{
					"name": "Banner",
					"slug": "banner",
					"gradient": "linear-gradient(90deg, var(--wp--preset--color--wash) 0%, color-mix(in srgb, var(--wp--preset--color--wash) 82%, transparent) 45%, transparent 90%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "Poppins",
					"slug": "poppins",
					"fontFamily": "Poppins, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Poppins",
							"fontStyle": "normal",
							"fontWeight": "300",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/poppins-latin-300-normal.woff2"
							],
