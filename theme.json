				},
				{
					"name": "Lora",
					"slug": "lora",
					"fontFamily": "Lora, Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Lora",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/lora-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Lora",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/lora-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"name": "System",
					"slug": "system",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif"
				}
			],
			"fontSizes": [
				{
					"name": "X Small",
					"slug": "x-small",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1rem",
					"fluid": false
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.25rem",
					"fluid": false
				},
				{
					"name": "X Large",
					"slug": "x-large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.375rem"
					}
				},
				{
					"name": "Heading",
					"slug": "heading",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"name": "Display",
					"slug": "display",
					"size": "3.125rem",
					"fluid": {
						"min": "2rem",
						"max": "3.125rem"
					}
				},
				{
					"name": "Colossal",
					"slug": "colossal",
					"size": "4.375rem",
					"fluid": {
						"min": "2.375rem",
						"max": "4.375rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"padding": true,
			"margin": true,
			"blockGap": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "20",
					"slug": "20",
					"size": "0.5rem"
				},
				{
					"name": "30",
					"slug": "30",
					"size": "1rem"
				},
				{
					"name": "40",
					"slug": "40",
					"size": "1.5rem"
				},
				{
					"name": "50",
					"slug": "50",
					"size": "clamp(1.75rem, 3vw, 2.5rem)"
				},
				{
					"name": "60",
					"slug": "60",
					"size": "clamp(2.5rem, 4vw, 3.4375rem)"
				},
				{
					"name": "70",
					"slug": "70",
					"size": "clamp(3rem, 6vw, 5rem)"
				},
				{
					"name": "80",
					"slug": "80",
					"size": "clamp(4rem, 8vw, 7.5rem)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Card",
					"slug": "card",
					"shadow": "0 6px 10px rgba(0, 0, 0, 0.04)"
				},
				{
					"name": "Header",
					"slug": "header",
					"shadow": "0 3px 16px 0 rgba(0, 0, 0, 0.1)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--muted)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--poppins)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0px",
				"bottom": "0px",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "500",
					"lineHeight": "1.25"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "1rem"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-deep)"
					}
				}
			},
			"button": {
				"color": {
					"gradient": "var(--wp--preset--gradient--brand)",
					"text": "var(--wp--preset--color--on-primary)"
				},
				"typography": {
					"fontFamily": "inherit",
					"fontWeight": "500",
					"fontSize": "0.9375rem",
					"lineHeight": "1.5"
				},
				"border": {
					"radius": "4px",
					"width": "1px",
					"style": "solid",
					"color": "transparent"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "2.25rem",
						"right": "2.25rem"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--divider)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontWeight": "600",
					"fontSize": "1.625rem",
					"lineHeight": "1.2"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.9375rem",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--surface)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)",
						"left": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)"
					}
				},
				"typography": {
					"fontStyle": "normal"
				}
			},
			"core/pullquote": {
				"border": {
					"top": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "2px"
					},
					"bottom": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page without banner",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-with-sidebar",
			"title": "Page with sidebar",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "single-no-sidebar",
			"title": "Post without sidebar",
			"postTypes": [
				"post"
			]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "sidebar",
			"title": "Sidebar",
			"area": "uncategorized"
		}
	]
}
