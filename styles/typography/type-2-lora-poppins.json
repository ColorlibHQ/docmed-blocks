{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lora headings, Poppins text",
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--poppins)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)"
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--lora)"
				}
			}
		}
	}
}
