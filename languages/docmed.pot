msgid "Docmed"
msgstr ""

#. Theme URI of the theme
#: style.css
msgid "https://colorlib.com/wp/themes/docmed/"
msgstr ""

#. Description of the theme
#: style.css
msgid "A block theme for family clinics, medical centres and doctors' practices. Departments, a doctors carousel and grid, patient reviews, tabs, and an appointment request form (department, doctor, date and time) that opens from the header — plus contact and newsletter forms, none of which needs a plugin. Eight colour palettes, five type pairings, visitor dark mode and WooCommerce support. Full site editing throughout."
msgstr ""

